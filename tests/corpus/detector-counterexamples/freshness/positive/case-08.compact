pragma language_version >= 0.23;
import CompactStandardLibrary;
export ledger startedAt8: Uint<64>;
export ledger authenticated8: Boolean;
constructor() { startedAt8 = 0; authenticated8 = false; }
export circuit authenticate8(expectedTimeWindow: Uint<64>): [] {
  assert(disclose(expectedTimeWindow >= startedAt8), "window");
  startedAt8 = disclose(expectedTimeWindow);
  authenticated8 = true;
}
