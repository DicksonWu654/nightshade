pragma language_version >= 0.26.0;
import { persistentHash } from CompactStandardLibrary;
export ledger credentialHash: Bytes<32>;
witness credential(): Uint<64>;
new type Digest = Bytes<32>;

circuit encode(value: Bytes<32>): Digest {
  return value as Digest;
}

export circuit reveal(): Digest {
  const secret = credential();
  const digest = persistentHash<Uint<64>>(secret);
  assert(digest == credentialHash, "credential");
  return disclose(encode(digest));
}
