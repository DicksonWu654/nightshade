pragma language_version >= 0.20;

import CompactStandardLibrary;

// Synthetic source-pattern regression.
// Operation and state names below are illustrative, not recovered APIs.
export ledger owner: Either<Bytes<32>, ContractAddress>;
export ledger roleMembers: Set<Bytes<32>>;
export ledger tokenPermissions: Map<Bytes<32>, Bytes<32>>;
export ledger fungiblePermissions: Map<Bytes<32>, Bytes<32>>;
export ledger multiTokenPermissions: Map<Bytes<32>, Bytes<32>>;
export ledger nonFungibleOwners: Map<Bytes<32>, Bytes<32>>;
export ledger ownerActions: Counter;
export ledger roleActions: Counter;
export ledger tokenActions: Counter;
export ledger fungibleActions: Counter;
export ledger multiTokenActions: Counter;
export ledger nonFungibleActions: Counter;

constructor(
  configuredOwner: Either<Bytes<32>, ContractAddress>,
  configuredRoleMember: Bytes<32>,
  tokenId: Bytes<32>,
  configuredTokenMember: Bytes<32>,
  fungibleId: Bytes<32>,
  multiTokenId: Bytes<32>,
  nonFungibleId: Bytes<32>
) {
  owner = disclose(configuredOwner);
  roleMembers.insert(disclose(configuredRoleMember));
  tokenPermissions.insert(disclose(tokenId), disclose(configuredTokenMember));
  fungiblePermissions.insert(disclose(fungibleId), disclose(configuredTokenMember));
  multiTokenPermissions.insert(disclose(multiTokenId), disclose(configuredTokenMember));
  nonFungibleOwners.insert(disclose(nonFungibleId), disclose(configuredTokenMember));
}

// Preserve the original owned fixture entrypoint and its protected state effect.
export circuit ownerAction(): [] {
  assert(owner.is_left, "contract-owner invocation semantics not represented");
  assert(ownPublicKey().bytes == owner.left, "owner key");
  ownerActions.increment(1);
}

export circuit roleAction(): [] {
  assert(roleMembers.member(disclose(ownPublicKey().bytes)), "role member");
  roleActions.increment(1);
}

export circuit tokenPermissionAction(tokenId: Bytes<32>): [] {
  assert(tokenPermissions.member(disclose(tokenId)), "token permission exists");
  assert(tokenPermissions.lookup(disclose(tokenId)) == ownPublicKey().bytes, "token permission key");
  tokenActions.increment(1);
}

// Owned example authorization/effect sites for the remaining named modules.
export circuit fungibleTokenAction(assetId: Bytes<32>): [] {
  assert(fungiblePermissions.member(disclose(assetId)), "fungible permission exists");
  assert(fungiblePermissions.lookup(disclose(assetId)) == ownPublicKey().bytes, "fungible permission key");
  fungibleActions.increment(1);
}

export circuit multiTokenAction(tokenClass: Bytes<32>): [] {
  assert(multiTokenPermissions.member(disclose(tokenClass)), "multi-token permission exists");
  assert(multiTokenPermissions.lookup(disclose(tokenClass)) == ownPublicKey().bytes, "multi-token permission key");
  multiTokenActions.increment(1);
}

export circuit nonFungibleTokenAction(tokenId: Bytes<32>): [] {
  assert(nonFungibleOwners.member(disclose(tokenId)), "NFT owner exists");
  assert(nonFungibleOwners.lookup(disclose(tokenId)) == ownPublicKey().bytes, "NFT owner key");
  nonFungibleActions.increment(1);
}
