import CompactStandardLibrary;
// Record-shaped ownPublicKey authorization or stored-key association.
export ledger owner: Bytes<32>;
export ledger value: Field;
witness localSecretKey(): Bytes<32>;
circuit publicKey(sk: Bytes<32>): Bytes<32> { return persistentHash<Bytes<32>>(sk); }
export ledger posterPk: Bytes<32>;
export circuit post(): [] { posterPk = disclose(ownPublicKey().bytes); }
export circuit takeDown(): [] { assert(publicKey(localSecretKey()) == owner, "secret authorization"); assert(posterPk == ownPublicKey().bytes, "poster association"); value = value - value; }
