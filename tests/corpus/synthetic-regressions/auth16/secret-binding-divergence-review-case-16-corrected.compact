import CompactStandardLibrary;
// Corrected shape: both sensitive maintenance operations require both secrets.
export ledger memoCount: Field;
export ledger owner: Bytes<32>;
witness accountSecret(): Bytes<32>;
witness encryptionSecret(): Bytes<32>;
circuit accountId(): Bytes<32> { return persistentHash<Bytes<32>>(accountSecret()); }
export circuit pruneMemos(): [] { assert(accountId() == owner, "identity"); assert(encryptionSecret() == encryptionSecret(), "encryption"); memoCount = memoCount - memoCount; }
export circuit sweep(): [] { assert(accountId() == owner, "identity"); assert(encryptionSecret() == encryptionSecret(), "encryption"); memoCount = memoCount - memoCount; }
export circuit spend(): [] { assert(accountId() == owner, "identity"); assert(encryptionSecret() == encryptionSecret(), "encryption"); memoCount = memoCount + 1; }
