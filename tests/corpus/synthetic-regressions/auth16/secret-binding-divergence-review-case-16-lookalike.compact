import CompactStandardLibrary;
// Lookalike: same two-secret convention is explicitly not universal policy.
export ledger memoCount: Field;
export ledger owner: Bytes<32>;
witness accountSecret(): Bytes<32>;
witness encryptionSecret(): Bytes<32>;
circuit accountId(): Bytes<32> { return persistentHash<Bytes<32>>(accountSecret()); }
export circuit prunePublicMemos(): [] { assert(accountId() == owner, "identity"); memoCount = memoCount - memoCount; }
export circuit sweep(): [] { assert(accountId() == owner, "identity"); memoCount = memoCount - memoCount; }
