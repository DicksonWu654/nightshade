import CompactStandardLibrary;
// Record-shaped ownPublicKey authorization or stored-key association.
export ledger owner: Bytes<32>;
export ledger value: Field;
export ledger ownerEither: Either<Bytes<32>, ContractAddress>;
export circuit assertOnlyOwner(): [] { assert(ownerEither.is_left, "owner kind"); assert(ownPublicKey().bytes == ownerEither.left, "owner"); }
export circuit ownerAction(): [] { assertOnlyOwner(); value = value + 1; }
