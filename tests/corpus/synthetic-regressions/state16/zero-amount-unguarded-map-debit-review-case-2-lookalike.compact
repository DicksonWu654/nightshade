pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger balances: Map<Bytes<32>, Map<Bytes<32>, Uint<64>>>;
export circuit update(source: Bytes<32>, to: Bytes<32>, token: Bytes<32>, amount: Uint<64>): [] {
 if (balances.lookup(disclose(source)).member(disclose(token))) {
  const fromPrior = balances.lookup(disclose(source)).lookup(disclose(token));
  balances.lookup(disclose(source)).insert(disclose(token), disclose((fromPrior - disclose(amount)) as Uint<64>));
 }
}
