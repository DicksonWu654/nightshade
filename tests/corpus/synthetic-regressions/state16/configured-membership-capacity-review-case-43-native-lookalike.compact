pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

// Owned one-approval boundary. This models no specific production policy.
export ledger registered: Set<Bytes<32>>;
export ledger threshold: Uint<8>;

struct SignerClaim {
  commitment: Bytes<32>;
  signature: Secp256k1EcdsaSignature;
  key: Secp256k1Point;
}

circuit signerCommitment(key: Secp256k1Point): Bytes<32> {
  return persistentHash<Vector<2, Secp256k1Base>>([
    secp256k1PointX(key), secp256k1PointY(key)
  ]);
}

constructor(signer: Secp256k1Point) {
  registered.insert(signerCommitment(disclose(signer)));
  threshold = 1 as Uint<8>;
}

export circuit gatedOperation(claim: SignerClaim, message: Bytes<32>): [] {
  assert(registered.member(disclose(claim.commitment)), "registered signer");
  assert(claim.commitment == signerCommitment(claim.key), "key binding");
  const valid = secp256k1EcdsaVerify(disclose(message), claim.signature, claim.key);
  assert(valid, "signature");
  const accepted: Uint<8> = valid ? 1 as Uint<8> : 0 as Uint<8>;
  assert(accepted >= threshold, "threshold");
  round.increment(1);
}
