// Recommended fix rejects zero-value calls; concurrency effect remains external.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger recipientMemos: Map<Bytes<32>, List<Bytes<32>>>;
export circuit initRecipient(recipient: Bytes<32>): [] { recipientMemos.insertDefault(disclose(recipient)); }
export circuit credit(recipient: Bytes<32>, memoCiphertext: Bytes<32>, amount: Uint<64>): [] {
 assert(disclose(amount) > 0, "nonzero credit");
 const previousLength = recipientMemos.lookup(disclose(recipient)).length();
 recipientMemos.lookup(disclose(recipient)).pushFront(disclose(memoCiphertext));
}
