// Synthetic source-pattern regression.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export circuit _mint(amount: Uint<64>, nonce: Bytes<32>): ShieldedCoinInfo {
 return mintShieldedToken(pad(32, "coin-domain"), disclose(amount), disclose(nonce), left<ZswapCoinPublicKey, ContractAddress>(default<ZswapCoinPublicKey>));
}
export circuit _burn(coin: QualifiedShieldedCoinInfo, amount: Uint<128>): ShieldedSendResult {
 return sendShielded(disclose(coin), right<ZswapCoinPublicKey, ContractAddress>(kernel.self()), disclose(amount));
}
