pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger round: Counter;
ledger allowed: MerkleTree<2, Field>;
ledger nullifiers: Set<Field>;
witness ticketPath(candidate: Field): MerkleTreePath<2, Field>;
witness votePath(candidate: Field): MerkleTreePath<2, Field>;
witness issuerPath(candidate: Field): MerkleTreePath<2, Field>;
witness itemPath(candidate: Field): MerkleTreePath<2, Field>;
witness authPath(candidate: Field): MerkleTreePath<2, Field>;
witness secret(): Bytes<32>;
witness ticketSecret(): Bytes<32>;
witness voteSecret(): Bytes<32>;
witness issuerKey(): Bytes<32>;
witness item(): Field;
export circuit check(): [] {
 const candidate = item();
 const p = itemPath(candidate);
 assert(p.leaf == candidate, "bind item");
 assert(allowed.checkRoot(disclose(merkleTreePathRoot<2, Field>(p))), "item membership");
 round.increment(1);
}
export circuit increment(): [] {
 const candidate = transientHash<Bytes<32>>(secret());
 const p = authPath(candidate);
 assert(p.leaf == candidate, "bind authorization key");
 assert(allowed.checkRoot(disclose(merkleTreePathRoot<2, Field>(p))), "authorization membership");
 nullifiers.insert(disclose(transientHash<Vector<2, Bytes<32>>>([pad(32, "docs-nullifier"), secret()])));
 round.increment(1);
}
