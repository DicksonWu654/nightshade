pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

export circuit signedIncrement(msg: Vector<1, Field>, sig: JubjubSchnorrSignature, pk: JubjubPoint): [] {
  assert(jubjubSchnorrVerify<1>(msg, sig, default<JubjubPoint>), "signature");
  round.increment(1);
}

// Owned independent-witness lookalike: the published digest and point use distinct inputs.
export ledger publishedDigest: Bytes<32>;
export ledger generatorPoint: JubjubPoint;
witness digestSeedMaterial(): Bytes<32>;
witness pointSeedMaterial(): Bytes<32>;
pure circuit publishDigest(seed: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<1, Bytes<32>>>([seed]);
}
pure circuit deriveGeneratorPoint(seed: Bytes<32>): JubjubPoint {
  const scalar = degradeToTransient(persistentHash<Vector<1, Bytes<32>>>([seed])) as JubjubScalar;
  return ecMulGenerator(scalar);
}
export circuit registerSeed(): [] {
  const digestSeed = digestSeedMaterial();
  const pointSeed = pointSeedMaterial();
  publishedDigest = disclose(publishDigest(digestSeed));
  generatorPoint = disclose(deriveGeneratorPoint(pointSeed));
}
