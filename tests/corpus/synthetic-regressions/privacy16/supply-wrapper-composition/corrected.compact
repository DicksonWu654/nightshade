pragma language_version >= 0.26.0;
import CompactStandardLibrary;
// POLICY: choose exactly one PublicSupply wrapper for a token.
export ledger supply: Counter;
export circuit mint(amount: Uint<64>): [] { supply.increment(disclose(amount as Uint<16>)); }
export circuit burn(amount: Uint<64>): [] { supply.decrement(disclose(amount as Uint<16>)); }
