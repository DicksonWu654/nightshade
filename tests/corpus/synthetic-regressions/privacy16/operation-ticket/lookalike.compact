pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger round: Counter;
ledger allowed: MerkleTree<2, Field>;
ledger nullifiers: Set<Field>;
witness ticketPath(candidate: Field): MerkleTreePath<2, Field>;
witness votePath(candidate: Field): MerkleTreePath<2, Field>;
witness issuerPath(candidate: Field): MerkleTreePath<2, Field>;
witness itemPath(candidate: Field): MerkleTreePath<2, Field>;
witness authPath(candidate: Field): MerkleTreePath<2, Field>;
witness secret(): Bytes<32>;
witness ticketSecret(): Bytes<32>;
witness voteSecret(): Bytes<32>;
witness issuerKey(): Bytes<32>;
witness item(): Field;
export circuit spendTicket(): [] {
  const ticketCommitment = transientHash<Bytes<32>>(ticketSecret());
  const supplied = ticketPath(ticketCommitment);
  const p = MerkleTreePath<2, Field>{ leaf: ticketCommitment, path: supplied.path };
  assert(allowed.checkRoot(disclose(merkleTreePathRoot<2, Field>(p))), "ticket membership");
  nullifiers.insert(disclose(transientHash<Vector<2, Bytes<32>>>([pad(32, "ticket-spend"), ticketSecret()])));
  round.increment(1);
}
export circuit useTicket(): [] {
  const ticketCommitment = transientHash<Bytes<32>>(secret());
  const supplied = ticketPath(ticketCommitment);
  const p = MerkleTreePath<2, Field>{ leaf: ticketCommitment, path: supplied.path };
  assert(allowed.checkRoot(disclose(merkleTreePathRoot<2, Field>(p))), "ticket membership");
  round.increment(1);
}
