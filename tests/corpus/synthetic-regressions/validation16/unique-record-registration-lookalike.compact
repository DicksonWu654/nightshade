pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger records: Map<Bytes<32>, Opaque<"string">>;
export circuit register(id: Bytes<32>, payload: Opaque<"string">): [] {
  assert(disclose(id) == default<Bytes<32>>, "reserved id");
  assert(!records.member(disclose(id)), "duplicate id");
  records.insert(disclose(id), disclose(payload));
}
