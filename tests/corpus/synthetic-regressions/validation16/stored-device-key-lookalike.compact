pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger jubjubDevice: JubjubPoint;
export ledger secpDevice: Secp256k1Point;
export circuit enroll(j: JubjubPoint, s: Secp256k1Point): [] {
  jubjubDevice = disclose(j);
  secpDevice = disclose(s);
}
export circuit authorizeSchnorr(msg: Vector<1, Field>, sig: JubjubSchnorrSignature): [] {
  assert(msg[0] != 0 as Field, "nonempty message");
  assert(jubjubSchnorrVerify<1>(msg, sig, jubjubDevice), "device signature");
}
export circuit authorizeEcdsa(msg: Bytes<32>, sig: Secp256k1EcdsaSignature): [] {
  assert(msg != default<Bytes<32>>, "nonempty message");
  assert(secp256k1EcdsaVerify(msg, sig, secpDevice), "device signature");
}
