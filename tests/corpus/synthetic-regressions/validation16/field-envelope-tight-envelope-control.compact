pragma language_version >= 0.26.0;
import CompactStandardLibrary;

// A standalone bounded integer quotient relation. The quotient is represented
// in Uint<7> and narrowed to the intended envelope before Field recomposition.
witness quotientAndRemainder(): [Uint<7>, Uint<248>];
export circuit checkBoundedTranscript(hash: Field): [] {
  const [q, r] = quotientAndRemainder();
  assert(disclose(q) < 116, "tight quotient envelope");
  assert(hash == (q as Field) * (452312848583266388373324160190187140051835877600158453279131187530910662656 as Field) + (r as Field), "bounded recomposition");
}
