pragma language_version >= 0.26.0;
import CompactStandardLibrary;
witness splitChallenge(): [Field, Uint<248>];
export circuit check(hash: Field): [] {
  const [q, r] = splitChallenge();
  assert(q != 0 as Field, "nonzero quotient");
  assert(hash == q * (452312848583266388373324160190187140051835877600158453279131187530910662656 as Field) + (r as Field), "challenge decomposition");
}
