pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}
// Owned intentional lookalike: the API is restricted to nonzero debits.
export ledger balances: Map<Bytes<32>, Uint<64>>;
export circuit debit(domain: Bytes<32>, amount: Uint<64>): [] {
  if (disclose(amount) != 0 as Uint<64>) {
    const prior = balances.lookup(disclose(domain));
    balances.insert(disclose(domain), disclose((prior - amount) as Uint<64>));
  }
}
