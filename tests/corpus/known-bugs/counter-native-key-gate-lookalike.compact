pragma language_version >= 0.20;

import CompactStandardLibrary;

export ledger secretOwnerCommitment: Bytes<32>;
export ledger posterPk: Bytes<32>;
export ledger actions: Counter;

witness localSecretKey(): Bytes<32>;

constructor(secretCommitment: Bytes<32>) {
  secretOwnerCommitment = disclose(secretCommitment);
}

export circuit publish(): [] {
  posterPk = disclose(ownPublicKey().bytes);
}

export circuit previewCallerKey(): Boolean {
  return disclose(posterPk == ownPublicKey().bytes);
}
