pragma language_version >= 0.20;

import CompactStandardLibrary;

export ledger ownerCommitment: Bytes<32>;
export ledger actions: Counter;

witness secretNonce(): Bytes<32>;

constructor(commitment: Bytes<32>) {
  ownerCommitment = disclose(commitment);
}

export circuit setOwnerSetting(next: Field): [] {
  // The nonce is the credential; ownPublicKey is not an independently authenticated factor.
  assert(persistentHash<Bytes<32>>(secretNonce()) == ownerCommitment, "owner nonce commitment");
  actions.increment(1);
}
