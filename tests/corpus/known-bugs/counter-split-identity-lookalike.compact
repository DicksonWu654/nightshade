pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

export circuit forward(coin: ShieldedCoinInfo, recipient: Either<ZswapCoinPublicKey, ContractAddress>): [] {
  sendImmediateShielded(disclose(coin), disclose(recipient), 1);
  round.increment(1);
}
// Owned split-witness identity seed adapted from the canonical Counter source above.

module SplitAccessModule {
  export ledger splitAuthorizedIdentityHash: Bytes<32>;
  witness splitAuthorizationSecret(): Bytes<32>;

  export circuit splitIdentity(): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "auth:"), splitAuthorizationSecret()]);
  }

  export circuit splitRequireAuthorization(): [] {
    assert(splitIdentity() == splitAuthorizedIdentityHash, "authorized identity");
  }
}

module SplitAssetModule {
  export ledger splitBalances: Map<Bytes<32>, Uint<64>>;
  witness splitAssetCallerSecret(): Bytes<32>;

  export circuit splitIdentity(): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "auth:"), splitAssetCallerSecret()]);
  }

  export circuit splitCredit(amount: Uint<64>): [] {
    const previewedIdentity = splitIdentity();
    assert(previewedIdentity == previewedIdentity, "informational preview");
  }
}

import SplitAccessModule prefix SplitAccess_;
import SplitAssetModule prefix SplitAsset_;

export circuit splitAuthorizedCredit(amount: Uint<64>): [] {
  SplitAccess_splitRequireAuthorization();
  SplitAsset_splitCredit(amount);
}
