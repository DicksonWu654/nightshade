pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

export ledger recipientMemos: Map<Bytes<32>, List<Bytes<32>>>;
witness freshCoinNonce(): Bytes<32>;
witness freshMemoEphemeral(): Bytes<32>;

export circuit initRecipient(recipientKey: Bytes<32>): [] {
  assert(!recipientMemos.member(disclose(recipientKey)), "recipient List absent");
  recipientMemos.insertDefault(disclose(recipientKey));
}

export circuit credit(
  recipientKey: Bytes<32>,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  amount: Uint<64>
): [] {
  assert(recipient.is_left, "shielded recipient");
  assert(recipient.left.bytes == disclose(recipientKey), "memo owner matches recipient");
  const memoCount = recipientMemos.lookup(disclose(recipientKey)).length();
  mintShieldedToken(pad(32, "counter-mapped-credit"), disclose(amount), disclose(freshCoinNonce()), disclose(recipient));
  recipientMemos.lookup(disclose(recipientKey)).pushFront(disclose(freshMemoEphemeral()));
}

export circuit pruneRecipientMemos(recipientKey: Bytes<32>): [] {
  recipientMemos.lookup(disclose(recipientKey)).resetToDefault();
}
