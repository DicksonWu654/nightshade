pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

witness parts(): [Uint<7>, Uint<248>];
export circuit check(value: Field): [] {
  const [q, r] = parts();
  assert(q < 116, "quotient range");
  assert(value == (q as Field) * (452312848583266388373324160190187140051835877600158453279131187530910662656 as Field) + (r as Field), "arithmetic relation");
  round.increment(1);
}
