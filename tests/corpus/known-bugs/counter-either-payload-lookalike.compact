pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

export circuit rebuiltIncrement(allowed: Either<Field, Field>): [] {
  assert(!allowed.is_left, "right admission");
  const rebuilt = Either<Field, Field> { is_left: true, left: allowed.left, right: 0 as Field };
  assert(rebuilt.left == (0 as Field), "explicitly rebuilt left");
  round.increment(1);
}
