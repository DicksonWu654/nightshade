// Owned discarded-comparison seed; retain ordinary initialization/ownership APIs.

// WARNING: FOR TESTING PURPOSES ONLY.
// This contract exposes internal circuits and bypasses safety checks that the
// corresponding production contract relies on. DO NOT deploy or use this
// contract in any production application.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;

import "access/Ownable" prefix Ownable_;

export { ContractAddress, Either, Maybe };

export ledger count: Counter;

/**
 * @description `isInit` is a param for testing.
 *
 * If `isInit` is false, the constructor will not initialize the contract.
 * This behavior is to test that circuits are not callable unless the
 * contract is initialized.
*/
constructor(initialOwner: Either<Bytes<32>, ContractAddress>, isInit: Boolean) {
  if (disclose(isInit)) {
    Ownable_initialize(initialOwner);
  }
}

export circuit owner(): Either<Bytes<32>, ContractAddress> {
  return Ownable_owner();
}

export circuit transferOwnership(newOwner: Either<Bytes<32>, ContractAddress>): [] {
  return Ownable_transferOwnership(newOwner);
}

export circuit _unsafeTransferOwnership(newOwner: Either<Bytes<32>, ContractAddress>): [] {
  return Ownable__unsafeTransferOwnership(newOwner);
}

export circuit renounceOwnership(): [] {
  return Ownable_renounceOwnership();
}

export circuit assertOnlyOwner(): [] {
  return Ownable_assertOnlyOwner();
}

export circuit _transferOwnership(newOwner: Either<Bytes<32>, ContractAddress>): [] {
  return Ownable__transferOwnership(newOwner);
}

export circuit _unsafeUncheckedTransferOwnership(newOwner: Either<Bytes<32>, ContractAddress>): [] {
  return Ownable__unsafeUncheckedTransferOwnership(newOwner);
}


// Enforce the limit while preserving the existing owner requirement.
export circuit increment(limit: Uint<64>): [] {
  Ownable_assertOnlyOwner();
  assert(count.read() < disclose(limit), "count limit");
  count.increment(1);
}
