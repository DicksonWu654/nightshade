// Owned metadata lifecycle lifecycle seed composed with OpenZeppelin's pinned NFT library.
// Library revision: ec1331cd8195694c747d291e8fc8ab6d2914a976.
// Focused wrapper shape adapted from MockNonFungibleToken.compact.
// Mock source SHA-256: 7b9b4fb525c14d976b900be4efa9334e724a55c00f8579705a45e841f44f5ef0.
// TEST ONLY: exercises a declared current-incarnation URI cache policy.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
import "token/NonFungibleToken" prefix NFT_;
export ledger cachedURI: Map<Uint<128>, Opaque<"string">>;

constructor(name: Opaque<"string">, symbol: Opaque<"string">) {
  NFT_initialize(name, symbol);
}

export circuit replaceToken(
  recipient: Bytes<32>, tokenId: Uint<128>,
  oldURI: Opaque<"string">, newURI: Opaque<"string">
): Opaque<"string"> {
  assert(recipient != default<Bytes<32>>, "recipient");
  const owner = left<Bytes<32>, ContractAddress>(disclose(recipient));
  NFT__mint(owner, tokenId);
  cachedURI.insert(disclose(tokenId), disclose(oldURI));
  NFT__burn(tokenId);
  NFT__mint(owner, tokenId);
  cachedURI.insert(disclose(tokenId), disclose(newURI));
  return cachedURI.lookup(disclose(tokenId));
}
