pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

export ledger digest: Bytes<32>;
export circuit hashDifference(enabled: Boolean, a: Uint<128>, b: Uint<128>): [] {
  const active = disclose(enabled);
  const safeA = active ? a : 0 as Uint<128>;
  const safeB = active ? b : 0 as Uint<128>;
  if (active) {
    const change = (safeA - safeB) as Uint<128>;
    digest = disclose(persistentHash<Uint<128>>(change));
  }
}
