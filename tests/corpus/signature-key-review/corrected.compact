pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

export ledger enrolled: JubjubPoint;

export circuit enroll(pk: JubjubPoint): [] { assert(pk != default<JubjubPoint>, "nonidentity enrollment"); enrolled = disclose(pk); }

// Guard the persisted value at use as well as rejecting identity enrollment.
export circuit signedIncrement(msg: Vector<1, Field>, sig: JubjubSchnorrSignature): [] {
  assert(enrolled != default<JubjubPoint>, "nonidentity enrolled key");
  assert(jubjubSchnorrVerify<1>(msg, sig, enrolled), "signature");
  round.increment(1);
}
