pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

// One supplied identity snapshot drives both the digest and membership predicate.
pragma language_version >= 0.26.0;
export ledger memoState: Map<Bytes<32>, List<Bytes<32>>>;
export ledger permitted: Set<Bytes<32>>;
witness suppliedIdentity(): Bytes<32>;
export circuit initialize(wallet: Bytes<32>): [] {
  memoState.insertDefault(disclose(wallet));
}
export circuit addMemo(wallet: Bytes<32>, memo: Bytes<32>): [] {
  memoState.lookup(disclose(wallet)).pushFront(disclose(memo));
}
export circuit registerIdentity(identity: Bytes<32>): [] {
  permitted.insert(disclose(identity));
}
export circuit clearOne(wallet: Bytes<32>): [] {
  const identitySnapshot = suppliedIdentity();
  const authenticatedDigest = persistentHash<Bytes<32>>(identitySnapshot);
  assert(authenticatedDigest == disclose(wallet), "wallet digest");
  assert(permitted.member(disclose(identitySnapshot)), "permitted identity");
  assert(!memoState.lookup(disclose(wallet)).isEmpty(), "memo exists");
  memoState.lookup(disclose(wallet)).popFront();
}
