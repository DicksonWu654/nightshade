pragma language_version >= 0.23;
import CompactStandardLibrary;

export ledger totalSupply: Uint<64>;
constructor() { totalSupply = 0; }

export circuit mintCapped(amount: Uint<64>): [] {
  assert(amount <= 1000, "cap");
  totalSupply = (totalSupply + disclose(amount)) as Uint<64>;
  mintUnshieldedToken(pad(32, "gap:lookalike"), disclose(amount), disclose(left<ContractAddress, UserAddress>(kernel.self())));
}
