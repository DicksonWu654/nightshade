pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export circuit pay(coin: ShieldedCoinInfo, recipient: Either<ZswapCoinPublicKey, ContractAddress>): [] {
  assert(recipient.is_left, "contract recipient unsupported");
  sendImmediateShielded(disclose(coin), disclose(recipient), 1);
}
