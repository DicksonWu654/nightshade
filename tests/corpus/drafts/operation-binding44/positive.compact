import CompactStandardLibrary;
// The same reusable preimage predicate authorizes unrelated state changes.
export ledger controller: Bytes<32>;
export ledger document: Field;
witness localSecretKey(): Bytes<32>;
circuit authorize(): [] { assert(persistentHash<Bytes<32>>(localSecretKey()) == controller, "controller"); }
export circuit updateDocument(next: Field): [] { authorize(); document = disclose(next); }
export circuit revokeDocument(): [] { authorize(); document = document - document; }

// Owned lifecycle supplement: initialize controller state and document at construction.
constructor(controllerSeed: Bytes<32>) {
  controller = disclose(controllerSeed);
  document = 0 as Field;
}
