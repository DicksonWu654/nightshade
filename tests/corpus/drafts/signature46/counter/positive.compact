pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

// Supplemental owned dual-verifier source based on enrollment44/counter/positive.compact.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger enrolled: JubjubPoint;
export ledger secpEnrolled: Secp256k1Point;
constructor(seed: JubjubPoint, secpSeed: Secp256k1Point) {
  assert(seed != default<JubjubPoint>, "nonidentity constructor seed");
  enrolled = disclose(seed);
  secpEnrolled = disclose(secpSeed);
}
export circuit enroll(pk: JubjubPoint, secpPk: Secp256k1Point): [] {
  enrolled = disclose(pk);
  secpEnrolled = disclose(secpPk);
}
export circuit signedAction(msg: Vector<1, Field>, sig: JubjubSchnorrSignature, digest: Bytes<32>, ecdsaSig: Secp256k1EcdsaSignature): [] {
  assert(jubjubSchnorrVerify<1>(msg, sig, enrolled), "Jubjub signature");
  assert(secp256k1EcdsaVerify(digest, ecdsaSig, secpEnrolled), "ECDSA signature");
  round.increment(1);
}
