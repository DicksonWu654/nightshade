pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

// Supplemental owned dual-verifier source based on enrollment44/counter/positive.compact.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger enrolled: JubjubPoint;
export ledger secpEnrolled: Secp256k1Point;
constructor(seed: JubjubPoint, secpSeed: Secp256k1Point) {
  assert(ecMul(seed, 8 as JubjubScalar) != default<JubjubPoint>, "nonidentity constructor seed");
  assert(secpSeed != default<Secp256k1Point>, "nonidentity secp constructor seed");
  enrolled = disclose(seed);
  secpEnrolled = disclose(secpSeed);
}
export circuit enroll(pk: JubjubPoint, secpPk: Secp256k1Point): [] {
  assert(ecMul(pk, 8 as JubjubScalar) != default<JubjubPoint>, "nonidentity enrollment");
  assert(secpPk != default<Secp256k1Point>, "nonidentity secp enrollment");
  enrolled = disclose(pk);
  secpEnrolled = disclose(secpPk);
}
export circuit signedAction(msg: Vector<1, Field>, sig: JubjubSchnorrSignature, digest: Bytes<32>, ecdsaSig: Secp256k1EcdsaSignature): [] {
  const jubjubSnapshot = enrolled;
  const secpSnapshot = secpEnrolled;
  assert(ecMul(jubjubSnapshot, 8 as JubjubScalar) != default<JubjubPoint>, "nonidentity verifier snapshot");
  assert(secpSnapshot != default<Secp256k1Point>, "nonidentity secp verifier snapshot");
  assert(jubjubSchnorrVerify<1>(msg, sig, jubjubSnapshot), "Jubjub signature");
  assert(secp256k1EcdsaVerify(digest, ecdsaSig, secpSnapshot), "ECDSA signature");
  round.increment(1);
}
export circuit verifyKnownGenerators(msg: Vector<1, Field>, js: JubjubSchnorrSignature, digest: Bytes<32>, es: Secp256k1EcdsaSignature, secpScalar: Secp256k1Scalar): Boolean {
  assert(secpScalar != default<Secp256k1Scalar>, "nonzero secp generator scalar");
  return jubjubSchnorrVerify<1>(msg, js, ecMulGenerator(1 as JubjubScalar)) && secp256k1EcdsaVerify(digest, es, ecMulGenerator(secpScalar));
}
