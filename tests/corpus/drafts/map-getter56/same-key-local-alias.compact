pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger roleAdmin: Map<Bytes<32>, Bytes<32>>;
// Documentation claims DEFAULT_ADMIN_ROLE is customizable by roleAdmin entry.
export circuit setAdmin(role: Bytes<32>, admin: Bytes<32>): [] { const writeRole = disclose(role); roleAdmin.insert(writeRole, disclose(admin)); }
circuit storedAdmin(key: Bytes<32>): Bytes<32> { if (roleAdmin.member(disclose(key))) return roleAdmin.lookup(disclose(key)); return default<Bytes<32>>; }
export circuit getRoleAdmin(role: Bytes<32>): Bytes<32> { const queryRole = role; return storedAdmin(queryRole); }
