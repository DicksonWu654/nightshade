pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger roleAdmin: Map<Bytes<32>, Bytes<32>>;
// Documentation claims DEFAULT_ADMIN_ROLE is customizable by roleAdmin entry.
export circuit setAdmin(role: Bytes<32>, admin: Bytes<32>): [] { roleAdmin.insert(disclose(role), disclose(admin)); }
export circuit getRoleAdmin(role: Bytes<32>): Bytes<32> {
  if (roleAdmin.member(disclose(role))) return roleAdmin.lookup(disclose(role));
  return default<Bytes<32>>;
}
