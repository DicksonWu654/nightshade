// Owned source-shape candidate; no runtime or exploit claim.
import CompactStandardLibrary;
export ledger admins: Set<Bytes<32>>;
export ledger lpRoles: Set<Bytes<32>>;
export ledger traders: Set<Bytes<32>>;
export ledger value: Field;
// Native key is only a coin route; role status is a public query and gates no state write.
export circuit routedCoinRecipient(): Bytes<32> { return ownPublicKey().bytes; }
export circuit adminStatus(account: Bytes<32>): Boolean { return admins.member(disclose(account)); }
