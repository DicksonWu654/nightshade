pragma language_version >= 0.23.0;
import CompactStandardLibrary;
export ledger accountId: Bytes<32>;
export ledger rootJubjubPoint: JubjubPoint;
witness accountKeyMaterial(): Bytes<32>;
witness encryptionKeyMaterial(): Bytes<32>;
pure circuit accountDigest(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<1, Bytes<32>>>([secret]);
}
pure circuit secretToField(secret: Bytes<32>): Field {
  return degradeToTransient(persistentHash<Vector<1, Bytes<32>>>([secret]));
}
pure circuit derivePoint(secret: Bytes<32>): JubjubPoint {
  return ecMulGenerator(secretToField(secret));
}
export circuit register(): [] {
  const accountSecret = accountKeyMaterial();
  const encryptionSecret = encryptionKeyMaterial();
  accountId = disclose(accountDigest(accountSecret));
  rootJubjubPoint = disclose(derivePoint(encryptionSecret));
}
