pragma language_version >= 0.26.0;
import CompactStandardLibrary;

export ledger used: Set<Bytes<32>>;
witness nonce(): Bytes<32>;

export circuit enforceAbsenceLate(
  amount: Uint<64>, color: Bytes<32>, destination: Either<ContractAddress, UserAddress>
): [] {
  const id = nonce();
  const wasFresh = !used.member(disclose(id));
  used.insert(disclose(id));
  assert(wasFresh, "nonce was fresh before insert");
  sendUnshielded(disclose(color), disclose(amount), disclose(destination));
}
