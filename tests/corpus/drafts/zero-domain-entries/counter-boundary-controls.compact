pragma language_version >= 0.20;
import CompactStandardLibrary;

export ledger round: Counter;
export circuit increment(): [] { round.increment(1); }
export ledger balances: Map<Bytes<32>, Uint<64>>;
export ledger boundedBalances: Map<Bytes<32>, Uint<64>>;
export ledger initializedBalances: Map<Bytes<32>, Uint<64>>;
export ledger deletedBalances: Map<Bytes<32>, Uint<64>>;
export ledger resetBalances: Map<Bytes<32>, Uint<64>>;
export ledger intentionalZeroRecords: Map<Bytes<32>, Uint<64>>;

export circuit unrelatedFeeGuard(domain: Bytes<32>, fee: Uint<64>, amount: Uint<64>): [] {
  if (disclose(fee) > 0) {
    balances.insert(disclose(domain), disclose(amount));
  }
  increment();
}

export circuit differentKey(domain: Bytes<32>, other: Bytes<32>, amount: Uint<64>): [] {
  if (!balances.member(disclose(domain))) {
    balances.insert(disclose(other), disclose(amount));
  }
  increment();
}

export circuit boundedKey(amount: Uint<64>): [] {
  boundedBalances.insert(pad(32, "public-supply"), disclose(amount));
  increment();
}

export circuit updateExisting(domain: Bytes<32>, amount: Uint<64>): [] {
  if (initializedBalances.member(disclose(domain))) {
    initializedBalances.insert(disclose(domain), disclose(amount));
  }
  increment();
}

export circuit writeThenRemove(domain: Bytes<32>, amount: Uint<64>): [] {
  deletedBalances.insert(disclose(domain), disclose(amount));
  deletedBalances.remove(disclose(domain));
  increment();
}
export circuit writeThenReset(domain: Bytes<32>, amount: Uint<64>): [] {
  resetBalances.insert(disclose(domain), disclose(amount));
  resetBalances.resetToDefault();
  increment();
}

// Intentional zero-valued records are part of this API's documented behavior.
export circuit recordZero(domain: Bytes<32>): [] {
  intentionalZeroRecords.insert(disclose(domain), 0 as Uint<64>);
  increment();
}
