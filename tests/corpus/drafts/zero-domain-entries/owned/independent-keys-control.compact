pragma language_version >= 0.20;
import CompactStandardLibrary;
export ledger supply: Map<Bytes<32>, Uint<64>>;
export circuit credit(checked: Bytes<32>, inserted: Bytes<32>, amount: Uint<64>): [] {
  if (supply.member(disclose(checked))) {
    supply.insert(disclose(inserted), disclose(amount));
  }
}
