// Synthetic source-pattern regression.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;

export ledger accountIdentity: Map<Bytes<32>, Bytes<32>>;
export ledger encryptionIdentity: Map<Bytes<32>, Bytes<32>>;
export ledger balances: Map<Bytes<32>, Uint<64>>;
export ledger memos: Map<Bytes<32>, List<Bytes<32>>>;

witness accountSecret(): Bytes<32>;
witness encryptionSecret(): Bytes<32>;

circuit accountDigest(secretValue: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "binding account identity v1"), secretValue]) as Bytes<32>;
}
circuit encryptionDigest(secretValue: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "binding encryption identity v1"), secretValue]) as Bytes<32>;
}

// Enrollment is a source-shape stand-in for already-present account records.
export circuit enroll(account: Bytes<32>, initialBalance: Uint<64>): [] {
  accountIdentity.insert(disclose(account), disclose(accountDigest(accountSecret())));
  encryptionIdentity.insert(disclose(account), disclose(encryptionDigest(encryptionSecret())));
  balances.insert(disclose(account), disclose(initialBalance));
  memos.insertDefault(disclose(account));
}

// Finding-shaped weak maintenance: both guards prove only the identity secret.
export circuit clearMemos(account: Bytes<32>): [] {
  assert(accountDigest(accountSecret()) == accountIdentity.lookup(disclose(account)), "account identity");
  memos.lookup(disclose(account)).resetToDefault();
}
export circuit sweep(account: Bytes<32>): [] {
  assert(accountDigest(accountSecret()) == accountIdentity.lookup(disclose(account)), "account identity");
  balances.insert(disclose(account), 0 as Uint<64>);
  memos.lookup(disclose(account)).resetToDefault();
}

// Source-described value-moving siblings authenticate both pre-existing records.
export circuit moveValue(sourceAccount: Bytes<32>, to: Bytes<32>, amount: Uint<64>, memo: Bytes<32>): [] {
  assert(accountDigest(accountSecret()) == accountIdentity.lookup(disclose(sourceAccount)), "account identity");
  assert(encryptionDigest(encryptionSecret()) == encryptionIdentity.lookup(disclose(sourceAccount)), "encryption secret");
  balances.insert(disclose(sourceAccount), balances.lookup(disclose(sourceAccount)) - disclose(amount));
  balances.insert(disclose(to), (balances.lookup(disclose(to)) + disclose(amount)) as Uint<64>);
  memos.lookup(disclose(to)).pushFront(disclose(memo));
}

export circuit payValue(sourceAccount: Bytes<32>, to: Bytes<32>, amount: Uint<64>): [] {
  assert(accountDigest(accountSecret()) == accountIdentity.lookup(disclose(sourceAccount)), "account identity");
  assert(encryptionDigest(encryptionSecret()) == encryptionIdentity.lookup(disclose(sourceAccount)), "encryption secret");
  balances.insert(disclose(sourceAccount), balances.lookup(disclose(sourceAccount)) - disclose(amount));
  balances.insert(disclose(to), (balances.lookup(disclose(to)) + disclose(amount)) as Uint<64>);
}
