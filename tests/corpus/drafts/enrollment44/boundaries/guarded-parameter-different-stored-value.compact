pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger enrolled: JubjubPoint;
export ledger actions: Field;
constructor(seed: JubjubPoint) {
  assert(seed != default<JubjubPoint>, "nonidentity constructor seed");
  enrolled = disclose(seed);
}
export circuit enroll(pk: JubjubPoint, actualStored: JubjubPoint): [] {
  assert(pk != default<JubjubPoint>, "nonidentity parameter");
  enrolled = disclose(actualStored);
}
export circuit signedAction(msg: Vector<1, Field>, sig: JubjubSchnorrSignature): [] {
  const snapshot = enrolled;
  assert(jubjubSchnorrVerify<1>(msg, sig, snapshot), "signature");
  actions = actions + 1 as Field;
}
