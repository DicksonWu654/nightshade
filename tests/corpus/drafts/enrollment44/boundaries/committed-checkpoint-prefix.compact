pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger enrolled: JubjubPoint;
constructor(seed: JubjubPoint) {
  assert(seed != default<JubjubPoint>, "nonidentity constructor seed");
  enrolled = disclose(seed);
}
export circuit enrollThenCheck(pk: JubjubPoint): [] {
  enrolled = disclose(pk);
  kernel.checkpoint();
  assert(pk != default<JubjubPoint>, "later point check");
}
export circuit signedAction(msg: Vector<1, Field>, sig: JubjubSchnorrSignature): [] {
  assert(jubjubSchnorrVerify<1>(msg, sig, enrolled), "signature");
}
