pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

// Owned enrollment source scenario appended to the preserved Apache Counter prefix.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger enrolled: JubjubPoint;
constructor(seed: JubjubPoint) {
  assert(seed != default<JubjubPoint>, "nonidentity constructor seed");
  enrolled = disclose(seed);
}
export circuit enroll(pk: JubjubPoint): [] {
  assert(pk != default<JubjubPoint>, "nonidentity enrollment");
  enrolled = disclose(pk);
}
export circuit signedAction(msg: Vector<1, Field>, sig: JubjubSchnorrSignature): [] {
  assert(jubjubSchnorrVerify<1>(msg, sig, enrolled), "signature");
  round.increment(1);
}
