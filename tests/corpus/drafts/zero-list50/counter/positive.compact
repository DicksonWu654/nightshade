pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

// Owned Map getter-shaped Counter extension; no contention or impact claim.
pragma language_version >= 0.26.0;
export ledger recipientMemos: Map<Bytes<32>, List<Bytes<32>>>;
export circuit initRecipient(recipient: Bytes<32>): [] { recipientMemos.insertDefault(disclose(recipient)); }
export circuit credit(recipient: Bytes<32>, memoCiphertext: Bytes<32>, amount: Uint<64>): [] {
  const amountSnapshot = disclose(amount);
  const recipientSnapshot = disclose(recipient);
  const previousLength = recipientMemos.lookup(recipientSnapshot).length();
  sendUnshielded(default<Bytes<32>>, amountSnapshot, right<ContractAddress, UserAddress>(UserAddress { bytes: recipientSnapshot }));
  recipientMemos.lookup(recipientSnapshot).pushFront(disclose(memoCiphertext));
}
