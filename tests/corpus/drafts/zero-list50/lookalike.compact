// Owned Map getter-shaped source control: the transfer amount is related to retained recipient-list growth.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger recipientMemos: Map<Bytes<32>, List<Bytes<32>>>;
export circuit initRecipient(recipient: Bytes<32>): [] { recipientMemos.insertDefault(disclose(recipient)); }
export circuit credit(recipient: Bytes<32>, transferRecipient: Bytes<32>, memoCiphertext: Bytes<32>, amount: Uint<64>): [] {
  const amountSnapshot = disclose(amount);
  const recipientSnapshot = disclose(recipient);
  const transferRecipientSnapshot = disclose(transferRecipient);
  assert(recipientSnapshot != transferRecipientSnapshot, "separate memo and transfer recipients");
  const previousLength = recipientMemos.lookup(recipientSnapshot).length();
  sendUnshielded(default<Bytes<32>>, amountSnapshot, right<ContractAddress, UserAddress>(UserAddress { bytes: transferRecipientSnapshot }));
  recipientMemos.lookup(recipientSnapshot).pushFront(disclose(memoCiphertext));
}
