pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger accountIdentity: Map<Bytes<32>, Bytes<32>>;
export ledger encryptionIdentity: Map<Bytes<32>, Bytes<32>>;
export ledger balances: Map<Bytes<32>, Uint<64>>;
witness accountSecret(): Bytes<32>;
witness encryptionSecret(): Bytes<32>;
circuit accountDigest(secret: Bytes<32>): Bytes<32> { return persistentHash<Vector<2, Bytes<32>>>([pad(32, "binding account identity v1"), secret]) as Bytes<32>; }
circuit encryptionDigest(secret: Bytes<32>): Bytes<32> { return persistentHash<Vector<2, Bytes<32>>>([pad(32, "binding encryption identity v1"), secret]) as Bytes<32>; }
export circuit weakWriter(authenticatedKey: Bytes<32>, effectKey: Bytes<32>): [] {
  assert(accountDigest(accountSecret()) == accountIdentity.lookup(disclose(authenticatedKey)), "account identity");
  balances.insert(disclose(effectKey), 0 as Uint<64>);
}
export circuit strictPeer(account: Bytes<32>): [] {
  const exactKey = disclose(account);
  assert(accountDigest(accountSecret()) == accountIdentity.lookup(exactKey), "account identity");
  assert(encryptionDigest(encryptionSecret()) == encryptionIdentity.lookup(exactKey), "encryption identity");
  balances.insert(exactKey, 0 as Uint<64>);
}
