pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger accountIdentity: Map<Bytes<32>, Bytes<32>>;
export ledger encryptionIdentity: Map<Bytes<32>, Bytes<32>>;
export ledger balances: Map<Bytes<32>, Uint<64>>;
witness accountSecret(): Bytes<32>;
circuit accountDigest(secret: Bytes<32>): Bytes<32> { return persistentHash<Vector<2, Bytes<32>>>([pad(32, "binding account identity v1"), secret]) as Bytes<32>; }
circuit encryptionDomainDigest(secret: Bytes<32>): Bytes<32> { return persistentHash<Vector<2, Bytes<32>>>([pad(32, "binding encryption identity v1"), secret]) as Bytes<32>; }
export circuit weakWriter(account: Bytes<32>): [] {
  assert(accountDigest(accountSecret()) == accountIdentity.lookup(disclose(account)), "account identity");
  balances.insert(disclose(account), 0 as Uint<64>);
}
// Different domain, but the same canonical witness declaration is reused.
export circuit notDistinctBindingPeer(account: Bytes<32>): [] {
  assert(accountDigest(accountSecret()) == accountIdentity.lookup(disclose(account)), "account identity");
  assert(encryptionDomainDigest(accountSecret()) == encryptionIdentity.lookup(disclose(account)), "same witness");
  balances.insert(disclose(account), 0 as Uint<64>);
}
