pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger accountIdentity: Map<Bytes<32>, Bytes<32>>;
export ledger encryptionIdentity: Map<Bytes<32>, Bytes<32>>;
export ledger balances: Map<Bytes<32>, Uint<64>>;
witness accountSecret(): Bytes<32>;
witness encryptionSecret(): Bytes<32>;
circuit accountDigest(secret: Bytes<32>): Bytes<32> { return persistentHash<Vector<2, Bytes<32>>>([pad(32, "binding account identity v1"), secret]) as Bytes<32>; }
circuit encryptionDigest(secret: Bytes<32>): Bytes<32> { return persistentHash<Vector<2, Bytes<32>>>([pad(32, "binding encryption identity v1"), secret]) as Bytes<32>; }
circuit requireAccountBinding(key: Bytes<32>): [] {
  const selector = disclose(key);
  assert(accountDigest(accountSecret()) == accountIdentity.lookup(selector), "account identity");
}
circuit requireEncryptionBinding(key: Bytes<32>): [] {
  const selector = disclose(key);
  assert(encryptionDigest(encryptionSecret()) == encryptionIdentity.lookup(selector), "encryption identity");
}
export circuit weakerViaHelper(account: Bytes<32>): [] {
  const keyAlias = disclose(account);
  requireAccountBinding(account);
  balances.insert(keyAlias, 0 as Uint<64>);
}
export circuit strongerViaHelper(account: Bytes<32>): [] {
  const keyAlias = disclose(account);
  requireAccountBinding(account);
  requireEncryptionBinding(account);
  balances.insert(keyAlias, 0 as Uint<64>);
}
