// Owned supplemental correction; same lifecycle with contract-bound preimage.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
struct OwnerCommitment { selfAddress: ContractAddress; salt: Bytes<32>; owner: Bytes<32>; }
export ledger commitment: Bytes<32>;
export ledger initialized: Boolean;
export ledger limit: Uint<64>;
constructor() {
  initialized = false;
}
export circuit initialize(salt: Bytes<32>, ownerSecret: Bytes<32>): [] {
  assert(!initialized, "already initialized");
  assert(salt != pad(32, ""), "default salt forbidden");
  commitment = disclose(persistentHash<OwnerCommitment>(OwnerCommitment { selfAddress: kernel.self(), salt: salt, owner: ownerSecret }));
  initialized = true;
}
export circuit setLimit(salt: Bytes<32>, ownerSecret: Bytes<32>, nextLimit: Uint<64>): [] {
  assert(initialized, "not initialized");
  assert(disclose(persistentHash<OwnerCommitment>(OwnerCommitment { selfAddress: kernel.self(), salt: salt, owner: ownerSecret })) == commitment, "owner commitment mismatch");
  limit = disclose(nextLimit);
}
