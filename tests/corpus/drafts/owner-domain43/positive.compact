// Synthetic source-pattern regression.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
struct OwnerCommitment { salt: Bytes<32>; owner: Bytes<32>; }
export ledger commitment: Bytes<32>;
export ledger initialized: Boolean;
export ledger limit: Uint<64>;
constructor() {
  initialized = false;
}
export circuit initialize(salt: Bytes<32>, ownerSecret: Bytes<32>): [] {
  assert(!initialized, "already initialized");
  commitment = disclose(persistentHash<OwnerCommitment>(OwnerCommitment { salt: salt, owner: ownerSecret }));
  initialized = true;
}
export circuit setLimit(salt: Bytes<32>, ownerSecret: Bytes<32>, nextLimit: Uint<64>): [] {
  assert(initialized, "not initialized");
  assert(disclose(persistentHash<OwnerCommitment>(OwnerCommitment { salt: salt, owner: ownerSecret })) == commitment, "owner commitment mismatch");
  limit = disclose(nextLimit);
}
