// Owned boundary: published owner/salt commitment, without an authorization consumer.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
struct OwnerCommitment { salt: Bytes<32>; owner: Bytes<32>; }
export ledger commitment: Bytes<32>;
export ledger initialized: Boolean;
constructor() {
  initialized = false;
}
export circuit initialize(salt: Bytes<32>, ownerSecret: Bytes<32>): [] {
  assert(!initialized, "already initialized");
  commitment = disclose(persistentHash<OwnerCommitment>(OwnerCommitment { salt: salt, owner: ownerSecret }));
  initialized = true;
}
export circuit identifier(): Bytes<32> {
  return commitment;
}
