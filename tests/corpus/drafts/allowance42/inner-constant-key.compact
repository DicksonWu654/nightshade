// Owned quiet control: getter has dynamic spender; spend decrements a fixed inner key.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger allowances: Map<Bytes<32>, Map<Bytes<32>, Uint<64>>>;
export circuit allowance(owner: Bytes<32>, spender: Bytes<32>): Uint<64> {
 if (allowances.member(disclose(owner)) && allowances.lookup(disclose(owner)).member(disclose(spender))) return allowances.lookup(disclose(owner)).lookup(disclose(spender));
 return 0 as Uint<64>;
}
export circuit spend(owner: Bytes<32>, amount: Uint<64>): [] {
 const fixed = default<Bytes<32>>;
 assert(allowances.member(disclose(owner)), "owner exists");
 assert(allowances.lookup(disclose(owner)).member(fixed), "fixed inner key exists");
 const approved = allowances.lookup(disclose(owner)).lookup(fixed);
 allowances.lookup(disclose(owner)).insert(fixed, disclose((approved - disclose(amount)) as Uint<64>));
}
