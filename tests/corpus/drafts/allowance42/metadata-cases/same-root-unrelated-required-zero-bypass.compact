// Owned quiet metadata boundary. The selected allowance chain is bypassed
// entirely for amount zero; the separate same-root cell is still required.
pragma language_version >= 0.26.0;
import CompactStandardLibrary;
export ledger allowances: Map<Bytes<32>, Map<Bytes<32>, Uint<64>>>;
export ledger balances: Map<Bytes<32>, Map<Bytes<32>, Uint<64>>>;
export circuit allowance(owner: Bytes<32>, spender: Bytes<32>, token: Bytes<32>): Uint<64> {
 if (allowances.member(disclose(owner)) && allowances.lookup(disclose(owner)).member(disclose(spender))) return allowances.lookup(disclose(owner)).lookup(disclose(spender));
 return 0 as Uint<64>;
}
export circuit spend(owner: Bytes<32>, spender: Bytes<32>, requiredOwner: Bytes<32>, requiredSpender: Bytes<32>, source: Bytes<32>, to: Bytes<32>, token: Bytes<32>, amount: Uint<64>): [] {
 assert(owner != requiredOwner || spender != requiredSpender, "required allowance cell is distinct");
 assert(allowances.member(disclose(requiredOwner)), "required outer owner exists");
 assert(allowances.lookup(disclose(requiredOwner)).member(disclose(requiredSpender)), "required spender exists");
 if (disclose(amount) > 0) {
  const approved = allowances.lookup(disclose(owner)).lookup(disclose(spender));
  allowances.lookup(disclose(owner)).insert(disclose(spender), disclose((approved - disclose(amount)) as Uint<64>));
 }
 const prior = balances.lookup(disclose(source)).lookup(disclose(token));
 balances.lookup(disclose(source)).insert(disclose(token), disclose((prior - disclose(amount)) as Uint<64>));
 const received = balances.lookup(disclose(to)).lookup(disclose(token));
 balances.lookup(disclose(to)).insert(disclose(token), disclose((received + disclose(amount)) as Uint<64>));
}
