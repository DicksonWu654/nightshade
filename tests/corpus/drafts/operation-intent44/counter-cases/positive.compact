pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

// Owned operation-intent case: both document mutations use the same private-preimage check.
export ledger controllerCommitment: Bytes<32>;
export ledger authorizationNonce: Uint<64>;
export ledger document: Field;
witness localSecretKey(): Bytes<32>;
circuit authorize(): [] {
  assert(persistentHash<Bytes<32>>(localSecretKey()) == controllerCommitment, "controller preimage");
}
export circuit updateDocument(next: Field): [] {
  authorize();
  document = disclose(next);
}
export circuit revokeDocument(): [] {
  authorize();
  document = document - document;
}
constructor(controllerSeed: Bytes<32>) {
  controllerCommitment = persistentHash<Bytes<32>>(disclose(controllerSeed));
  authorizationNonce = 0 as Uint<64>;
  document = 0 as Field;
}
