pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state
export ledger round: Counter;

// transition function changing public state
export circuit increment(): [] {
  round.increment(1);
}

// Owned complementary-send Counter source control; no source-domain-f6e837 mapping.
pragma language_version >= 0.23.0;
import CompactStandardLibrary;
export circuit splitSend(color: Bytes<32>, recipient: Either<ContractAddress, UserAddress>, total: Uint<128>, part: Uint<128>): [] {
  assert(disclose(total) > 0 as Uint<128>, "positive total");
  assert(disclose(part) <= disclose(total), "part within total");
  const remainder = total - part;
  sendUnshielded(disclose(color), disclose(part), disclose(recipient));
  sendUnshielded(disclose(color), disclose(remainder), disclose(recipient));
  round.increment(1);
}
